{
  "name": "avenmail",
  "version": "0.0.0",
  "private": true,
  "description": "AvenMail: klient poczty Monorise (IMAP, SMTP) w przeglądarce, na komputerach i telefonach",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@aven/web",
    "dev:desktop": "pnpm --filter @aven/desktop tauri dev",
    "dev:mobile": "pnpm --filter @aven/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node scripts/check-versions.mjs",
    "openapi": "pnpm --filter @aven/web openapi",
    "openapi:check": "pnpm --filter @aven/web openapi:check",
    "check": "pnpm format:check && pnpm check:versions && pnpm openapi:check && turbo run lint typecheck test build",
    "setup:env": "node scripts/setup-env.mjs",
    "permissions:register": "pnpm --filter @aven/web permissions:register",
    "db:up": "docker compose up -d database",
    "db:migrate": "pnpm --filter @aven/db migrate:deploy && pnpm --filter @aven/db migrate:deploy:test",
    "mail:test-server": "docker compose up -d test-mail-server",
    "shared:update": "node scripts/shared.mjs update",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@monorise-team/config": "0.0.1-dev.27",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  }
}
