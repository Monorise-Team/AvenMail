# Przykładowa konfiguracja lokalna dla apps/web/.env.local.
# Lokalny plik wygenerujesz automatycznie poleceniem `pnpm setup:env`.
# Nigdy nie commituj prawdziwych kluczy, haseł ani plików `.env.local`.

# Szyfrowanie haseł do skrzynek pocztowych (32 bajty w base64)
AVEN_CREDENTIALS_KEY=replace-with-32-random-bytes-in-base64

# Szyfrowanie sesji przeglądarki BFF (co najmniej 32 znaki; przy rotacji „nowy,stary”)
AVEN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Zezwól na lokalne i prywatne serwery poczty (tylko lokalnie i w testach z GreenMail)
AVEN_ALLOW_PRIVATE_MAIL_HOSTS=1

# Adresy aplikacji pocztowej (BFF) i strony produktu / API
AVEN_MAIL_URL=http://aven-mail.localhost:3000
AVEN_API_URL=http://aven.localhost:3000

# Opcjonalna lista hostów przepisujących na /mail (domyślnie aven-mail.monorise.studio,aven-mail.localhost)
# AVEN_MAIL_HOSTS=aven-mail.monorise.studio,aven-mail.localhost

# Dozwolone pochodzenia CORS dla aplikacji na komputer (Tauri)
# AVEN_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1420

# Interwał odpytywania kanału zdarzeń Core w ms (0 wyłącza; domyślnie 5000 w development, 0 poza nim)
AVEN_EVENT_FEED_INTERVAL_MS=5000

# Baza PostgreSQL (rola aplikacji aven_mail_app, bez omijania RLS)
# W packages/db/.env do migracji użyj roli właściciela:
# DATABASE_URL=postgresql://aven_mail_owner:aven_mail_owner@localhost:5434/aven_mail
DATABASE_URL=postgresql://aven_mail_app:aven_mail_app@localhost:5434/aven_mail

# MonoriseCore (logowanie OAuth 2.1 i Core API)
CORE_AUTH_URL=http://localhost:3100
CORE_API_URL=http://localhost:3200
AVEN_OAUTH_CLIENT_ID=avenmail-web
AVEN_OAUTH_CLIENT_SECRET=replace-with-secret-from-monorise-core-oauth-seed

# Opcjonalna ścieżka pliku sekretów OAuth dla `pnpm setup:env` (np. przy git worktree)
# CORE_OAUTH_SECRETS_FILE=/sciezka/do/MonoriseCore/apps/auth/.data/oauth-clients.json
