{
  "name": "@aven/mail-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Ekrany poczty AvenMail wspólne dla przeglądarki i aplikacji na komputer",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aven/client": "workspace:*",
    "@aven/contracts": "workspace:*",
    "@monorise-team/ui": "0.0.1-dev.2",
    "@tanstack/react-query": "^5.90.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^1.76.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
