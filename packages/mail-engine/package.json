{
  "name": "@aven/mail-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Silnik poczty AvenMail na serwerze: IMAP, SMTP i parsowanie wiadomości, bez zapisu treści",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aven/contracts": "workspace:*",
    "imapflow": "^2.12.0",
    "mailparser": "^3.14.4",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.26",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
